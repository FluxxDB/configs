# TEMPLATE — copy to models/<name>.env and fill in. Based on the tuned qwen3.5-9b.env; the values
# below are a reasonable start for an ~8 GB 4-bit model on the 16 GB RX 7900 GRE.
# Use:  docker compose --env-file models/<name>.env up -d --wait

# Hugging Face repo id (downloaded into HF_HOME on first start), or a local checkpoint directory
# under HF_HOME. RDNA3 has no FP8/FP4 hardware: use bf16, AWQ, GPTQ or compressed-tensors W4A16
# (int4) checkpoints. FP8, NVFP4 and MXFP4 ones will not load. Weights + KV cache must fit in
# GPU_MEMORY_UTILIZATION x 16 GB, so ~10 GB of weights is the practical ceiling. int4 kernels on
# ROCm: group size 128 works in bf16; any other group size needs "--dtype float16" below.
MODEL_PATH=<org>/<model>
# Name clients put in the "model" field.
SERVED_NAME=<model>

# Max tokens per request (prompt + completion). Check "KV cache size" in the engine log: the cache
# must hold at least this many tokens, or vLLM refuses to start.
CONTEXT_SIZE=16384
# Concurrent requests.
MAX_NUM_SEQS=4
# Prefill chunk. Start-up profiling reserves memory per token of this, so lower it if the KV cache
# comes out too small. vLLM's default is 2048.
MAX_NUM_BATCHED_TOKENS=2048
# Share of the card's total VRAM (17.1 GB as reported) vLLM may use for weights + KV cache. It must
# be below what's free: Windows keeps ~2.5 GB for the desktop, so ~0.85 is the ceiling.
GPU_MEMORY_UTILIZATION=0.82

# Model-family parsers (empty disables): tool calls become OpenAI `tool_calls`, thinking lands in
# `reasoning_content`. See `vllm serve --help` for the others.
TOOL_CALL_PARSER=
REASONING_PARSER=
# Anything else for `vllm serve`, whitespace-split, e.g. "--seed 1 --max-logprobs 5".
VLLM_EXTRA_ARGS=

# Host port for http://localhost:PORT/v1
PORT=8000
HF_HOME=${HOME}/Projects/.huggingface
# Engine image; must be an RDNA3 (gfx110X) build. Defaults to the one in compose.yaml.
#VLLM_IMAGE=

# Compose CLI behaviour: no interactive shortcut menu at the bottom of an attached `up`.
COMPOSE_MENU=false
