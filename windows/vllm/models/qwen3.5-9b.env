# Qwen3.5-9B, 4-bit (compressed-tensors W4A16, group size 32), text only, on the RX 7900 GRE.
# Qwen3.5 is the architecture Qwen3.8 is built on; Qwen3.8's smallest model (27B) needs ~20 GB
# even at 4 bits, so it does not fit in 16 GB of VRAM with vLLM.
# Use:  docker compose --env-file models/qwen3.5-9b.env up -d --wait
# Measured: 7.9 GiB of weights, ~24-27k tokens of KV cache (varies with how much VRAM Windows is
# using), ~50 tokens/s for one request, ~3 min to start (~4.5 min the very first time).

MODEL_PATH=cyankiwi/Qwen3.5-9B-AWQ-4bit
SERVED_NAME=qwen3.5-9b

CONTEXT_SIZE=32768
MAX_NUM_SEQS=4
MAX_NUM_BATCHED_TOKENS=2048
GPU_MEMORY_UTILIZATION=0.82

# Qwen's recommended parsers for Qwen3.5: thinking -> reasoning_content, tool calls -> tool_calls.
TOOL_CALL_PARSER=qwen3_coder
REASONING_PARSER=qwen3
# --language-model-only skips the vision encoder, freeing VRAM for the KV cache (drop it to accept
# images). --dtype float16: on ROCm the only int4 kernel for group size 32 (Exllama) needs fp16
# activations; the bf16 default fails with "Failed to find a kernel ... WNA16".
VLLM_EXTRA_ARGS=--language-model-only --dtype float16

PORT=8000
HF_HOME=${HOME}/Projects/.huggingface
COMPOSE_MENU=false
