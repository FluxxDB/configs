# TEMPLATE — copy to models/<name>.env and fill in. Based on the tuned Gemma 4 26B-A4B file
# (MacBook Pro M5 Pro / 24 GB); the values below are a reasonable start for a ~15 GB MLX 4-bit model.
# Use:  docker compose -f <model>.compose.yaml --env-file models/<name>.env up -d

# Local MLX checkpoint directory (e.g. one made by scripts/convert-to-mlx-4bit.sh), or a Hugging
# Face repo id such as mlx-community/... which is downloaded into HF_HOME on first start.
MODEL_PATH=${HOME}/Projects/.huggingface/mlx/<model>-MLX-4bit
# Name clients put in the "model" field.
SERVED_NAME=<model>

# Max tokens per request (prompt + completion). Check "KV cache size" in the engine log: the cache
# must hold at least this many tokens, or vLLM refuses to start.
CONTEXT_SIZE=16384
# Concurrent requests.
MAX_NUM_SEQS=4
# Prefill chunk. Start-up profiling reserves memory per token of this (fp32 logits over the
# vocabulary), so lower it if the KV cache comes out too small. vLLM's default is 2048.
MAX_NUM_BATCHED_TOKENS=1024
# Share of the GPU working set vLLM may use for weights + KV cache (0.92 max in practice).
GPU_MEMORY_UTILIZATION=0.90

# Model-family parsers (empty disables): tool calls become OpenAI `tool_calls`, thinking lands in
# `reasoning_content`. Gemma 4 uses gemma4 for both; see `vllm serve --help` for the others.
TOOL_CALL_PARSER=
REASONING_PARSER=
# Anything else for `vllm serve`, e.g. "--seed 1 --max-logprobs 5".
VLLM_EXTRA_ARGS=

# Host port for http://localhost:PORT/v1
PORT=8000
HF_HOME=${HOME}/Projects/.huggingface

# Compose CLI behaviour: no interactive shortcut menu at the bottom of an attached `up`.
COMPOSE_MENU=false
